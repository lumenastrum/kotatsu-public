{
    "$schema": "../../kotatsu/theme/theme.schema.json",
    "id": "natsumikan-v3",
    "name": "Natsumikan",
    "author": "Clio for Kotatsu",
    "description": "Natsumikan, leaner: warm cream glass, indigo ink, mikan for what matters, periwinkle for choosing, mint and rose only as light at the edges.",
    "version": 1,
    "extends": "blue-hour",
    "palette": {
        "background": "#fbf1de",
        "panel": "#fffaf1",
        "text": "#2b2560",
        "prose": "#2f2a5a",
        "accent": "#b34a0a",
        "dialogue": "#5546b0",
        "actions": "#2c7562",
        "border": "#e6cfa8",
        "character-message": "#fffaf1",
        "user-message": "#fdeccf",
        "shadow": "#7a4a22",
        "glow-top": "#fdcb75",
        "glow-left": "#badcb6",
        "glow-bottom": "#f9c9d2",
        "success": "#2b7356",
        "warning": "#97500a",
        "danger": "#b3304b"
    },
    "tokens": {
        "--k-scrim": "#2b2560",
        "--k-surface-2": "#fffcf6",
        "--k-surface-sunken": "#f8ecd6",
        "--k-chrome-border": "#d9b98a",
        "--k-border-strength": "50%",
        "--k-elevation-shadow": "#7a4a22",
        "--k-blur-panel": "18px",

        "--k-control-on-strength": "26%",
        "--k-control-on-text": "var(--k-select)",
        "--k-primary-bg": "#f39a3c",
        "--k-primary-text": "#2b2560",
        "--k-primary-hover-bg": "#f7ab55",
        "--k-primary-weight": "700",

        "--k-radius-xs": "6px",
        "--k-radius-sm": "10px",
        "--k-radius-md": "14px",
        "--k-radius-lg": "18px",
        "--k-radius-xl": "24px",

        "--k-elev-1": "0 2px 10px -2px color-mix(in srgb, var(--k-elevation-shadow) 14%, transparent)",
        "--k-elev-2": "0 8px 24px -6px color-mix(in srgb, var(--k-elevation-shadow) 18%, transparent)",
        "--k-elev-3": "0 16px 40px -10px color-mix(in srgb, var(--k-elevation-shadow) 24%, transparent)",
        "--k-elev-3-soft": "0 16px 40px -12px color-mix(in srgb, var(--k-elevation-shadow) 18%, transparent)",
        "--k-elev-4": "0 28px 70px -16px color-mix(in srgb, var(--k-elevation-shadow) 30%, transparent)",

        "--k-font-ui": "'Zen Maru Gothic', 'IBM Plex Sans', system-ui, sans-serif",
        "--k-font-display": "'Fraunces', 'Zen Maru Gothic', Georgia, serif",
        "--k-display-weight": "700",
        "--k-font-name": "'Fraunces', 'Zen Maru Gothic', Georgia, serif",
        "--k-name-weight": "700",
        "--k-font-label": "'Zen Maru Gothic', 'IBM Plex Sans', sans-serif",
        "--k-label-case": "none",
        "--k-label-tracking": "0.01em",
        "--k-label-weight": "700",
        "--k-label-scale": "1.14",

        "--k-mes-line-height": "1.7",
        "--k-mes-weight": "440",

        "--k-app-backdrop": "url(\"bg/glow.svg\"), radial-gradient(ellipse 46% 42% at 94% -4%, color-mix(in srgb, #fdcb75 55%, transparent), transparent 72%), radial-gradient(ellipse 40% 36% at -4% 104%, color-mix(in srgb, #badcb6 40%, transparent), transparent 70%), radial-gradient(ellipse 36% 30% at 60% 110%, color-mix(in srgb, #f9c9d2 40%, transparent), transparent 70%), linear-gradient(180deg, #fef5e4, #fbecd2)",
