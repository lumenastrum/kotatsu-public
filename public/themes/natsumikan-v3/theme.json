        "--k-studio-token-2": "#f39a3c",
        "--k-studio-token-3": "#3fa98a",
        "--k-studio-token-4": "#b3304b",
        "--k-studio-token-5": "#8a84b8",

        "--k-onb-mikan": "#f39a3c",
        "--k-onb-peri": "#5546b0",
        "--k-onb-indigo": "#2b2560",
        "--k-onb-warm": "linear-gradient(180deg, #f8b262, #f0902f)",
