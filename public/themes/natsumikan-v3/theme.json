        "--k-studio-field-fill": "color-mix(in srgb, #ffffff 60%, transparent)",
        "--k-studio-sheet-fill": "color-mix(in srgb, #fffaf1 90%, transparent)",
        "--k-studio-scrim-fill": "color-mix(in srgb, #fbe3b8 45%, transparent)",
        "--k-studio-ring": "color-mix(in srgb, #f39a3c 40%, transparent)",
