        "--k-rc-btn-lift": "1px",
        "--k-rc-btn-primary-fill": "linear-gradient(180deg, #f8b262, #f0902f)",
        "--k-rc-btn-primary-fill-hover": "linear-gradient(180deg, #fabd73, #f39a3c)",
        "--k-rc-btn-primary-line": "color-mix(in srgb, #ffffff 45%, #f39a3c)",
        "--k-rc-btn-primary-ink": "#2b2560",
        "--k-rc-btn-primary-shadow": "inset 0 1px 0 color-mix(in srgb, #ffffff 55%, transparent), 0 8px 20px -8px color-mix(in srgb, #f0902f 80%, transparent)",
        "--k-rc-btn-primary-shadow-hover": "inset 0 1px 0 color-mix(in srgb, #ffffff 60%, transparent), 0 12px 26px -8px color-mix(in srgb, #f0902f 90%, transparent)",
        "--k-rc-seg-fill": "color-mix(in srgb, var(--k-chrome-border) 22%, color-mix(in srgb, #ffffff 40%, transparent))",
        "--k-rc-seg-line": "color-mix(in srgb, #ffffff 80%, transparent)",
        "--k-rc-seg-on-fill": "#fffdf8",
        "--k-rc-seg-on-ink": "#5546b0",
        "--k-rc-seg-on-shadow": "0 2px 8px -2px color-mix(in srgb, #7a4a22 30%, transparent)",

        "--k-cc-composer-fill": "linear-gradient(180deg, color-mix(in srgb, #ffffff 74%, transparent), color-mix(in srgb, #fffaf1 64%, transparent))",
        "--k-cc-composer-glow": "#f39a3c",
        "--k-cc-composer-line": "color-mix(in srgb, #ffffff 55%, var(--k-chrome-border))",
        "--k-cc-composer-line-focus": "color-mix(in srgb, #f39a3c 50%, #ffffff)",
        "--k-cc-composer-shadow": "inset 0 1px 0 color-mix(in srgb, #ffffff 90%, transparent), 0 0 0 3px color-mix(in srgb, #f39a3c 4%, transparent), 0 0 22px -6px color-mix(in srgb, #f39a3c 16%, transparent), 0 10px 24px -14px color-mix(in srgb, #7a4a22 28%, transparent)",
        "--k-cc-composer-shadow-focus": "inset 0 1px 0 #ffffff, 0 0 0 3px color-mix(in srgb, #f39a3c 14%, transparent), 0 0 28px -6px color-mix(in srgb, #f39a3c 40%, transparent), 0 10px 26px -14px color-mix(in srgb, #7a4a22 35%, transparent)"
    },
