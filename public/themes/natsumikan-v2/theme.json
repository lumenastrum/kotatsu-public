{
    "$schema": "../../kotatsu/theme/theme.schema.json",
    "id": "natsumikan-v2",
    "name": "Natsumikan Manga",
    "author": "Clio for Kotatsu",
    "description": "Natsumikan reworked on the Shoujo frame: a sunlit marigold page, indigo ink, mikan orange, periwinkle for choosing, mint and confetti at the edges.",
    "version": 1,
    "extends": "blue-hour",
    "palette": {
        "background": "#fde8b6",
        "panel": "#fff8e4",
        "text": "#2b2560",
        "prose": "#2f2a5a",
        "accent": "#b34a0a",
        "dialogue": "#5546b0",
        "actions": "#2c7562",
        "border": "#2b2560",
        "character-message": "#fffaec",
        "user-message": "#fdeccc",
        "shadow": "#2b2560",
        "glow-top": "#fdcb75",
        "glow-left": "#badcb6",
        "glow-bottom": "#fde3a0",
        "success": "#2b7356",
        "warning": "#97500a",
        "danger": "#b3304b"
    },
    "tokens": {
        "--k-scrim": "#211d4a",
        "--k-overlay-dark": "#e8cf98",
        "--k-surface-2": "#fffbee",
        "--k-surface-sunken": "#fdf1d4",
        "--k-border-strength": "55%",
        "--k-chrome-border": "#2b2560",
        "--k-elevation-shadow": "#2b2560",

        "--k-control-border": "color-mix(in srgb, var(--k-text) 78%, transparent)",
        "--k-control-on-strength": "26%",
        "--k-control-on-text": "var(--k-select)",
        "--k-primary-bg": "#f39a3c",
        "--k-primary-text": "#211d4a",
        "--k-primary-hover-bg": "#f7b25e",
        "--k-primary-weight": "700",

        "--k-radius-xs": "2px",
        "--k-radius-sm": "3px",
        "--k-radius-md": "4px",
        "--k-radius-lg": "4px",
        "--k-radius-xl": "6px",

        "--k-elev-1": "2px 2px 0 var(--k-elevation-shadow)",
        "--k-elev-2": "3px 3px 0 var(--k-elevation-shadow)",
        "--k-elev-3": "5px 5px 0 var(--k-elevation-shadow)",
        "--k-elev-3-soft": "5px 5px 0 color-mix(in srgb, var(--k-elevation-shadow) 85%, transparent)",
        "--k-elev-4": "8px 8px 0 var(--k-elevation-shadow)",
        "--k-avatar-bot-shadow": "3px 3px 0 var(--k-elevation-shadow)",
        "--k-avatar-user-shadow": "3px 3px 0 #f39a3c",

        "--k-font-ui": "'Zen Maru Gothic', 'IBM Plex Sans', system-ui, sans-serif",
        "--k-font-display": "'Fraunces', 'Zen Maru Gothic', Georgia, serif",
        "--k-display-weight": "800",
        "--k-font-name": "'Fraunces', 'Zen Maru Gothic', Georgia, serif",
        "--k-name-weight": "800",
        "--k-font-label": "'Zen Maru Gothic', 'IBM Plex Sans', sans-serif",
        "--k-label-case": "none",
        "--k-label-tracking": "0.02em",
        "--k-label-weight": "900",
        "--k-label-scale": "1.18",

        "--k-mes-line-height": "1.7",
        "--k-mes-weight": "440",

        "--k-material-library": "url(\"bg/light.svg\"), linear-gradient(90deg, transparent, var(--k-ground) 9%, var(--k-ground) 91%, transparent), url(\"textures/rings.svg\")",
        "--k-material-rail": "linear-gradient(180deg, var(--k-surface) 0, color-mix(in srgb, var(--k-surface) 0%, transparent) 220px), url(\"textures/tone.svg\")",
        "--k-material-topbar": "url(\"textures/tone.svg\")",
        "--k-app-backdrop": "url(\"bg/light.svg\"), url(\"textures/rings.svg\"), radial-gradient(ellipse 50% 46% at 92% -6%, color-mix(in srgb, #fdcb75 60%, transparent), transparent 72%), linear-gradient(180deg, #fef0c8, #fde3a6)",

        "--k-lib-title-size": "clamp(38px, 4vw, 60px)",
        "--k-lib-title-lh": "1.08",
        "--k-lib-title-track": "-0.01em",
        "--k-lib-name-size": "25px",
        "--k-lib-name-lh": "1.08",
        "--k-lib-card-radius": "3px",
        "--k-lib-card-border": "var(--k-text)",
        "--k-lib-card-fill": "var(--k-surface)",
        "--k-lib-card-pad": "14px",
        "--k-lib-grid-gap": "clamp(18px, 2vw, 28px)",
        "--k-lib-accent-s": "62%",
        "--k-lib-accent-l": "36%",
        "--k-lib-scrim-mid": "transparent",
        "--k-lib-scrim-deep": "transparent",
        "--k-lib-scrim-edge": "transparent",
        "--k-lib-glass": "color-mix(in srgb, var(--k-surface) 92%, transparent)",
        "--k-lib-field-fill": "var(--k-surface-2)",
        "--k-lib-hairline": "color-mix(in srgb, var(--k-text) 80%, transparent)",
        "--k-lib-hover-fill": "color-mix(in srgb, #f39a3c 16%, var(--k-surface-2))",
        "--k-lib-lift": "-3px",
        "--k-lib-portrait-rest": "0.98",

        "--k-studio-hairline": "color-mix(in srgb, var(--k-text) 80%, transparent)",
        "--k-studio-field-fill": "var(--k-surface-2)",
        "--k-studio-sheet-fill": "var(--k-surface)",
        "--k-studio-scrim-fill": "color-mix(in srgb, var(--k-scrim) 58%, transparent)",
        "--k-studio-ring": "color-mix(in srgb, #f39a3c 40%, transparent)",
        "--k-studio-hover-fill": "color-mix(in srgb, #f39a3c 14%, transparent)",
        "--k-studio-title-size": "clamp(24px, 2.2vw, 32px)",

        "--k-cc-name-size": "17px",

        "--k-studio-frame-line": "2px",
        "--k-studio-frame-color": "var(--k-text)",
        "--k-studio-sheet-shadow": "8px 8px 0 var(--k-text)",
        "--k-studio-panel-shadow": "4px 4px 0 var(--k-text)",
        "--k-studio-panel-radius": "3px",
        "--k-studio-field-radius": "3px",
        "--k-studio-field-fill": "var(--k-surface-2)",
        "--k-studio-stage-fill": "radial-gradient(ellipse 44% 36% at 50% 42%, #fffbee 30%, color-mix(in srgb, #fffbee 0%, transparent) 100%), repeating-conic-gradient(from 0deg at 50% 42%, color-mix(in srgb, #f39a3c 28%, transparent) 0deg 6deg, transparent 6deg 30deg), radial-gradient(circle at 50% 42%, #fff4c7, #fde3a0 70%)",
        "--k-studio-stage-floor": "linear-gradient(var(--k-text), var(--k-text)) left bottom 30px / 100% 2px no-repeat, repeating-conic-gradient(#f9c46a 0 25%, #fde3a0 0 50%) left bottom / 30px 30px repeat-x",
        "--k-studio-stage-floor-h": "30px",
        "--k-studio-name-shadow": "3px 3px 0 #f9c46a",
        "--k-studio-chapter-title-shadow": "3px 3px 0 #f9c46a",
        "--k-studio-eyebrow-fill": "var(--k-text)",
        "--k-studio-eyebrow-ink": "var(--k-surface)",
        "--k-studio-eyebrow-tilt": "-2deg",
        "--k-studio-next-fill": "#fdeccc",
        "--k-studio-next-line": "var(--k-text)",
        "--k-studio-token-1": "#5546b0",
        "--k-studio-token-2": "#f39a3c",
        "--k-studio-token-3": "#3fa98a",
        "--k-studio-token-4": "#b3304b",
        "--k-studio-token-5": "#8a84b8"
    },
    "assets": {
        "fonts": [
            { "family": "Fraunces", "src": "fonts/fraunces-soft-latin.woff2", "weight": "300 800", "style": "normal" },
            { "family": "Fraunces", "src": "fonts/fraunces-soft-italic-latin.woff2", "weight": "300 800", "style": "italic" },
            { "family": "Zen Maru Gothic", "src": "fonts/zen-maru-gothic-latin-500-normal.woff2", "weight": "300 600", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Zen Maru Gothic", "src": "fonts/zen-maru-gothic-latin-700-normal.woff2", "weight": "700 800", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Zen Maru Gothic", "src": "fonts/zen-maru-gothic-latin-900-normal.woff2", "weight": "900", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Zen Maru Gothic", "src": "fonts/zen-maru-gothic-latin-ext-500-normal.woff2", "weight": "300 600", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "family": "Zen Maru Gothic", "src": "fonts/zen-maru-gothic-latin-ext-700-normal.woff2", "weight": "700 900", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
        ]
    },
    "sheet": "sheet.css"
}
