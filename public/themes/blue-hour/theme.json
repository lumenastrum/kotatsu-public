{
    "$schema": "../../kotatsu/theme/theme.schema.json",
    "id": "blue-hour",
    "name": "Blue Hour",
    "version": 1,
    "tokens": {
        "--k-ground": "#0e1119",
        "--k-ground-deep": "#0d101b",
        "--k-surface": "#171b2c",
        "--k-surface-2": "#131726",
        "--k-surface-sunken": "#181d2a",
        "--k-panel-fill-soft": "linear-gradient(180deg,\n            color-mix(in srgb, var(--k-surface-2) 96%, transparent),\n            color-mix(in srgb, var(--k-ground-deep) 94%, transparent))",
        "--k-scrim": "#080a12",
        "--k-backdrop-top": "#171b2c",
        "--k-text": "#d8dce8",
        "--k-text-strong": "#eceef6",
        "--k-text-prose": "var(--k-text)",
        "--k-text-quote": "#c3c8da",
        "--k-text-dim": "#8891ad",
        "--k-text-muted": "#7f89ac",
        "--k-text-faint": "#6d7590",
        "--k-text-reasoning": "#949dc4",
        "--k-accent": "#9aa4d2",
        "--k-accent-bright": "#b6bee2",
        "--k-rose": "#dca9a4",
        "--k-rose-bright": "#e6bdb6",
        "--k-border": "#545e80",
        "--k-border-strength": "35%",
        "--k-shadow": "#000000",
        "--k-shadow-strength": "40%",
        "--k-chrome-border": "#545e80",
        "--k-elevation-shadow": "#000000",
        "--k-user-mes": "#202536",
        "--k-bot-mes": "#181d2a",
        "--k-chat-tint": "#0f121b",
        "--k-success": "#9ec49a",
        "--k-warning": "#cbb289",
        "--k-danger": "#c98a8a",
        "--k-info": "var(--k-accent)",
        "--k-danger-deep": "color-mix(in srgb, var(--k-danger) 42%, var(--k-scrim))",
        "--k-success-deep": "color-mix(in srgb, var(--k-success) 42%, var(--k-scrim))",
        "--k-checkbox-tick": "var(--k-rose)",
        "--k-glow-dawn": "#7e8cc8",
        "--k-glow-rose": "#966a8a",
        "--k-glow-deep": "#5a64a0",
        "--k-overlay-light": "var(--k-accent-bright)",
        "--k-overlay-dark": "var(--k-scrim)",
        "--k-italics": "var(--k-accent)",
        "--k-underline": "var(--k-accent-bright)",
        "--k-quote": "var(--k-rose)",
        "--k-radius-xs": "4px",
        "--k-radius-sm": "6px",
        "--k-radius-md": "8px",
        "--k-radius-lg": "10px",
        "--k-radius-xl": "12px",
        "--k-radius-pill": "999px",
        "--k-radius-round": "50%",
        "--k-topbar-pill-height": "44px",
        "--k-topbar-pill-inset": "10px",
        "--k-topbar-height": "64px",
        "--k-blur-panel": "12px",
        "--k-rail-left-width": "280px",
        "--k-rail-right-width": "340px",
        "--k-center-readable-min": "560px",
        "--k-elev-1": "0 2px 10px color-mix(in srgb, var(--k-elevation-shadow) 35%, transparent)",
        "--k-elev-2": "0 6px 24px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent)",
        "--k-elev-3": "0 10px 32px color-mix(in srgb, var(--k-elevation-shadow) 55%, transparent)",
        "--k-elev-3-soft": "0 10px 32px color-mix(in srgb, var(--k-elevation-shadow) 50%, transparent)",
        "--k-elev-4": "0 16px 48px color-mix(in srgb, var(--k-elevation-shadow) 60%, transparent)",
        "--k-ring-soft": "0 0 12px color-mix(in srgb, var(--k-rose) 28%, transparent),\r\n        inset 0 0 8px color-mix(in srgb, var(--k-rose) 6%, transparent)",
        "--k-ring-thumb": "0 0 0 3px color-mix(in srgb, var(--k-rose) 18%, transparent)",
        "--k-ring-thumb-hover": "0 0 0 5px color-mix(in srgb, var(--k-rose) 30%, transparent)",
        "--k-motion-duration": "150ms",
        "--k-motion": "var(--k-motion-duration) ease",
        "--k-avatar-motion": "180ms ease",
        "--k-avatar-border-w": "2px",
        "--k-avatar-gap": "2px",
        "--k-avatar-bot-shadow": "0 4px 16px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent),\n        0 0 12px color-mix(in srgb, var(--k-rose) 10%, transparent)",
        "--k-avatar-user-shadow": "0 4px 16px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent),\n        0 0 12px color-mix(in srgb, var(--k-accent) 12%, transparent)",
        "--k-font-ui": "var(--mainFontFamily)",
        "--k-font-prose": "var(--mainFontFamily)",
        "--k-font-display": "var(--k-font-prose)",
        "--k-display-weight": "500",
        "--k-font-mono": "var(--monoFontFamily)",
        "--k-mes-line-height": "1.65",
        "--k-mes-weight": "450",
        "--k-mes-para-gap": "0.85em",
        "--k-code-bg": "transparent",
        "--k-code-copy-opacity-rest": "0.5",
        "--k-code-copy-opacity-active": "1",
        "--k-code-text": "var(--k-text)",
        "--k-code-selection-bg": "color-mix(in srgb, var(--k-accent) 30%, transparent)",
        "--k-code-selection-text": "var(--k-text-strong)",
        "--k-code-comment": "var(--k-text-faint)",
        "--k-code-tag": "var(--k-text-reasoning)",
        "--k-code-punctuation": "var(--k-text-dim)",
        "--k-code-variable": "var(--k-text-quote)",
        "--k-code-attr": "var(--k-rose-bright)",
        "--k-code-title": "var(--k-accent-bright)",
        "--k-code-function": "var(--k-accent-bright)",
        "--k-code-strong": "var(--k-text-strong)",
        "--k-code-string": "var(--k-rose)",
        "--k-code-builtin": "var(--k-accent)",
        "--k-code-section": "var(--k-accent)",
        "--k-code-keyword": "var(--k-accent)",
        "--k-code-type": "var(--k-accent)",
        "--k-code-emphasis": "var(--k-italics)",
        "--k-code-meta": "var(--k-text-muted)",
        "--k-code-meta-keyword": "var(--k-accent)",
        "--k-code-meta-string": "var(--k-rose)"
    }
}
