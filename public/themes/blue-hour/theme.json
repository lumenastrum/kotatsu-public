{
    "$schema": "../../kotatsu/theme/theme.schema.json",
    "id": "blue-hour",
    "name": "Blue Hour",
    "version": 1,
    "tokens": {
        "--k-ground": "#11131a",
        "--k-ground-deep": "#0e1016",
        "--k-surface": "#1a1d27",
        "--k-surface-2": "#161821",
        "--k-surface-sunken": "#1d2029",
        "--k-panel-fill-soft": "linear-gradient(180deg, color-mix(in srgb, var(--k-surface-2) 96%, transparent), color-mix(in srgb, var(--k-ground-deep) 94%, transparent))",
        "--k-scrim": "#08090d",
        "--k-backdrop-top": "#1a1d27",
        "--k-text": "#dadce5",
        "--k-text-strong": "#eeeff5",
        "--k-text-prose": "var(--k-text)",
        "--k-text-quote": "#c5c8d6",
        "--k-text-dim": "#8b90a6",
        "--k-text-muted": "#8489a2",
        "--k-text-faint": "#6e7389",
        "--k-text-reasoning": "#9aa2c8",
        "--k-accent": "#9aa4d2",
        "--k-accent-bright": "#b6bee2",
        "--k-rose": "#e2ae9f",
        "--k-rose-bright": "#ecc3b6",
        "--k-border": "#4d5266",
        "--k-border-strength": "35%",
        "--k-shadow": "#000000",
        "--k-shadow-strength": "40%",
        "--k-chrome-border": "#4d5266",
        "--k-elevation-shadow": "#000000",
        "--k-user-mes": "#232633",
        "--k-bot-mes": "#1d2029",
        "--k-chat-tint": "#101219",
        "--k-success": "#9ec49a",
        "--k-warning": "#cbb289",
        "--k-danger": "#c98a8a",
        "--k-info": "var(--k-accent)",
        "--k-danger-deep": "color-mix(in srgb, var(--k-danger) 42%, var(--k-scrim))",
        "--k-success-deep": "color-mix(in srgb, var(--k-success) 42%, var(--k-scrim))",
        "--k-checkbox-tick": "var(--k-rose)",
        "--k-select": "var(--k-rose)",
        "--k-select-bright": "var(--k-rose-bright)",
        "--k-control-bg": "var(--k-surface-2)",
        "--k-control-border": "var(--k-border)",
        "--k-control-text": "var(--k-text)",
        "--k-control-on-strength": "20%",
        "--k-control-on-bg": "color-mix(in srgb, var(--k-select) var(--k-control-on-strength), var(--k-control-bg))",
        "--k-control-on-border": "var(--k-select)",
        "--k-control-on-text": "#f6dfd6",
        "--k-primary-bg": "var(--k-select)",
        "--k-primary-text": "var(--k-surface-2)",
        "--k-primary-hover-bg": "color-mix(in srgb, var(--k-primary-bg) 70%, var(--k-text-strong))",
        "--k-primary-weight": "600",
        "--k-glow-dawn": "#858eb6",
        "--k-glow-rose": "#966a8a",
        "--k-glow-deep": "#5c637f",
        "--k-overlay-light": "var(--k-accent-bright)",
        "--k-overlay-dark": "var(--k-scrim)",
        "--k-italics": "var(--k-accent)",
        "--k-underline": "var(--k-accent-bright)",
        "--k-quote": "var(--k-rose)",
        "--k-radius-xs": "4px",
        "--k-radius-sm": "6px",
        "--k-radius-md": "8px",
        "--k-radius-lg": "10px",
        "--k-radius-xl": "12px",
        "--k-radius-pill": "999px",
        "--k-radius-round": "50%",
        "--k-topbar-pill-height": "44px",
        "--k-topbar-pill-inset": "10px",
        "--k-topbar-height": "64px",
        "--k-blur-panel": "12px",
        "--k-rail-left-width": "280px",
        "--k-rail-right-width": "340px",
        "--k-center-readable-min": "560px",
        "--k-elev-1": "0 2px 10px color-mix(in srgb, var(--k-elevation-shadow) 35%, transparent)",
        "--k-elev-2": "0 6px 24px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent)",
        "--k-elev-3": "0 10px 32px color-mix(in srgb, var(--k-elevation-shadow) 55%, transparent)",
        "--k-elev-3-soft": "0 10px 32px color-mix(in srgb, var(--k-elevation-shadow) 50%, transparent)",
        "--k-elev-4": "0 16px 48px color-mix(in srgb, var(--k-elevation-shadow) 60%, transparent)",
        "--k-ring-soft": "0 0 12px color-mix(in srgb, var(--k-rose) 28%, transparent), inset 0 0 8px color-mix(in srgb, var(--k-rose) 6%, transparent)",
        "--k-ring-thumb": "0 0 0 3px color-mix(in srgb, var(--k-rose) 18%, transparent)",
        "--k-ring-thumb-hover": "0 0 0 5px color-mix(in srgb, var(--k-rose) 30%, transparent)",
        "--k-motion-duration": "150ms",
        "--k-motion": "var(--k-motion-duration) ease",
        "--k-avatar-motion": "180ms ease",
        "--k-dur-1": "120ms",
        "--k-dur-2": "180ms",
        "--k-dur-3": "240ms",
        "--k-ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
        "--k-ease-in": "cubic-bezier(0.55, 0, 1, 0.45)",
        "--k-ease-glide": "cubic-bezier(0.65, 0, 0.35, 1)",
        "--k-rise": "6px",
        "--k-avatar-border-w": "2px",
        "--k-avatar-gap": "2px",
        "--k-avatar-bot-shadow": "0 4px 16px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent), 0 0 12px color-mix(in srgb, var(--k-rose) 10%, transparent)",
        "--k-avatar-user-shadow": "0 4px 16px color-mix(in srgb, var(--k-elevation-shadow) 45%, transparent), 0 0 12px color-mix(in srgb, var(--k-accent) 12%, transparent)",
        "--k-font-ui": "var(--mainFontFamily)",
        "--k-font-prose": "var(--mainFontFamily)",
        "--k-font-display": "var(--k-font-prose)",
        "--k-display-weight": "500",
        "--k-font-mono": "var(--monoFontFamily)",
        "--k-mes-line-height": "1.65",
        "--k-mes-weight": "450",
        "--k-mes-para-gap": "0.85em",
        "--k-code-bg": "transparent",
        "--k-code-copy-opacity-rest": "0.5",
        "--k-code-copy-opacity-active": "1",
        "--k-code-text": "var(--k-text)",
        "--k-code-selection-bg": "color-mix(in srgb, var(--k-accent) 30%, transparent)",
        "--k-code-selection-text": "var(--k-text-strong)",
        "--k-code-comment": "var(--k-text-faint)",
        "--k-code-tag": "var(--k-text-reasoning)",
        "--k-code-punctuation": "var(--k-text-dim)",
        "--k-code-variable": "var(--k-text-quote)",
        "--k-code-attr": "var(--k-rose-bright)",
        "--k-code-title": "var(--k-accent-bright)",
        "--k-code-function": "var(--k-accent-bright)",
        "--k-code-strong": "var(--k-text-strong)",
        "--k-code-string": "var(--k-rose)",
        "--k-code-builtin": "var(--k-accent)",
        "--k-code-section": "var(--k-accent)",
        "--k-code-keyword": "var(--k-accent)",
        "--k-code-type": "var(--k-accent)",
        "--k-code-emphasis": "var(--k-italics)",
        "--k-code-meta": "var(--k-text-muted)",
        "--k-code-meta-keyword": "var(--k-accent)",
        "--k-code-meta-string": "var(--k-rose)",
        "--k-viz-1": "#3987e5",
        "--k-viz-2": "#d95926",
        "--k-viz-3": "#199e70",
        "--k-viz-4": "#c98500",
        "--k-viz-5": "#d55181",
        "--k-viz-other": "#7d8190",
        "--k-material-topbar": "none",
        "--k-material-rail": "none",
        "--k-material-reading": "none",
        "--k-material-message": "none",
        "--k-material-message-user": "none",
        "--k-material-composer": "none",
        "--k-material-library": "linear-gradient(180deg, color-mix(in srgb, var(--k-backdrop-top) 70%, transparent), var(--k-ground) 42%)",
        "--k-atmosphere": "none",
        "--k-atmosphere-opacity": "1",
        "--k-atmosphere-blend": "normal",
        "--k-atmosphere-mask": "none",
        "--k-atmosphere-motion": "none",
        "--k-atmosphere-period": "60s",
        "--k-atmosphere-travel": "0px",
        "--k-atmosphere-steps": "600",
        "--k-font-name": "var(--k-font-display)",
        "--k-name-weight": "var(--k-display-weight)",
        "--k-font-label": "initial",
        "--k-label-case": "initial",
        "--k-label-tracking": "initial",
        "--k-label-weight": "initial",
        "--k-label-scale": "1"
    }
}
