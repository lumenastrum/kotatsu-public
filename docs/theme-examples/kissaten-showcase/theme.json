{
    "$schema": "../../../public/kotatsu/theme/theme.schema.json",
    "id": "kissaten-showcase",
    "name": "Kissaten Showcase",
    "author": "Kotatsu",
    "description": "A Shōwa jazz kissaten at two in the morning: lacquered wood, amber lamps, rain on the window.",
    "version": 1,
    "extends": "blue-hour",
    "palette": {
        "background": "#120c09",
        "panel": "#1e1511",
        "text": "#eadfcb",
        "prose": "#e4d6bd",
        "accent": "#e0a157",
        "dialogue": "#e8bf86",
        "actions": "#d6a59c",
        "border": "#5c4431",
        "character-message": "#211813",
        "user-message": "#2b1a16",
        "shadow": "#040201",
        "glow-top": "#b0456a",
        "glow-left": "#a0642c",
        "glow-bottom": "#5a2418",
        "success": "#a3c48e",
        "warning": "#e6b866",
        "danger": "#e8907e"
    },
    "tokens": {
        "--k-radius-xs": "3px",
        "--k-radius-sm": "4px",
        "--k-radius-md": "6px",
        "--k-radius-lg": "7px",
        "--k-radius-xl": "9px",

        "--k-font-display": "'Gloock', 'Newsreader', Georgia, serif",
        "--k-display-weight": "400",
        "--k-font-name": "'Kalam', 'Gloock', cursive",
        "--k-name-weight": "400",
        "--k-font-label": "'Klee One', 'IBM Plex Sans', sans-serif",
        "--k-label-case": "none",
        "--k-label-tracking": "0.01em",
        "--k-label-weight": "600",
        "--k-label-scale": "1.3",

        "--k-mes-line-height": "1.72",
        "--k-mes-weight": "430",
        "--k-mes-para-gap": "0.9em",

        "--k-dur-2": "200ms",

        "--k-app-backdrop": "url(\"bg/kissaten.svg\"), radial-gradient(ellipse 46% 48% at 34% -10%, color-mix(in srgb, #f0a85a 34%, transparent), transparent 72%), radial-gradient(ellipse 26% 30% at 70% -6%, color-mix(in srgb, #f0a85a 17%, transparent), transparent 72%), linear-gradient(176deg, #1e140f 0%, #120c09 55%, #0a0605 100%)",

        "--k-material-topbar": "linear-gradient(180deg, color-mix(in srgb, #f2c88f 6%, transparent), transparent 75%), url(\"textures/walnut.svg\")",
        "--k-material-rail": "linear-gradient(180deg, color-mix(in srgb, #f2c88f 5%, transparent), transparent 35%), url(\"textures/walnut.svg\")",
        "--k-material-reading": "radial-gradient(ellipse 78% 52% at 50% -6%, color-mix(in srgb, #f0a85a 14%, transparent), transparent 72%), radial-gradient(ellipse 110% 70% at 50% 118%, color-mix(in srgb, #000000 38%, transparent), transparent 70%)",
        "--k-material-message": "linear-gradient(180deg, color-mix(in srgb, #f6c27e 16%, transparent) 0 1px, transparent 1px), linear-gradient(180deg, color-mix(in srgb, #f6c27e 5%, transparent), transparent 160px)",
        "--k-material-message-user": "linear-gradient(180deg, color-mix(in srgb, #f6c27e 10%, transparent) 0 1px, transparent 1px), url(\"textures/grain.svg\")",
        "--k-material-composer": "linear-gradient(180deg, color-mix(in srgb, #f2c88f 4%, transparent), transparent), url(\"textures/grain.svg\")",
        "--k-material-library": "var(--k-app-backdrop)",
        "--k-panel-fill": "url(\"textures/walnut.svg\"), linear-gradient(180deg, var(--k-surface-2), var(--k-ground-deep))",

        "--k-cc-name-size": "17px",
        "--k-bubble-name-size": "1.05em",
        "--k-cc-bubble-radius": "var(--k-radius-md)",
        "--k-cc-bubble-border": "color-mix(in srgb, var(--k-chrome-border) 32%, transparent)",
        "--k-lib-title-size": "clamp(40px, 4.4vw, 64px)",
        "--k-lib-title-track": "-0.01em",
        "--k-lib-card-radius": "var(--k-radius-md)",
        "--k-lib-accent-s": "46%",
        "--k-lib-accent-l": "70%"
    },
    "assets": {
        "fonts": [
            { "family": "Gloock", "src": "fonts/gloock-latin.woff2", "weight": "400 800", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Gloock", "src": "fonts/gloock-latin-ext.woff2", "weight": "400 800", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "family": "Kalam", "src": "fonts/kalam-400-latin.woff2", "weight": "300 500", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Kalam", "src": "fonts/kalam-400-latin-ext.woff2", "weight": "300 500", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "family": "Kalam", "src": "fonts/kalam-700-latin.woff2", "weight": "600 900", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Kalam", "src": "fonts/kalam-700-latin-ext.woff2", "weight": "600 900", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "family": "Klee One", "src": "fonts/klee-one-400-latin.woff2", "weight": "300 500", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Klee One", "src": "fonts/klee-one-400-latin-ext.woff2", "weight": "300 500", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "family": "Klee One", "src": "fonts/klee-one-600-latin.woff2", "weight": "600 900", "style": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "family": "Klee One", "src": "fonts/klee-one-600-latin-ext.woff2", "weight": "600 900", "style": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
        ]
    }
}
