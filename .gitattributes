# cannot reliably find labels in an LF-only batch file (docs/ship-v0.md, v0.2.3).
# scripts/release.mjs refuses to cut when either index holds it as LF.
Install[[:space:]]Kotatsu.bat -text
# Byte-identity fixtures: never normalize line endings or anything else (CLAUDE.md, "Verify before done").
tests/fixtures/** -text
